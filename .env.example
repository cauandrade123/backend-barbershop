PORT=3000
DB_HOST=localhost
DB_USER=root
DB_NAME=barbearia
DB_PWD=troque_esta_senha
JWT_SECRET=use_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Fuso do negócio, usado para decidir o que é "hoje" ao validar agendamentos.
TIMEZONE=America/Sao_Paulo

# Origens permitidas pelo CORS, separadas por vírgula.
# Vazio libera qualquer origem (aceitável só em desenvolvimento).
CORS_ORIGINS=

# Custo do bcrypt (10 a 15). Quanto maior, mais lento e mais seguro.
BCRYPT_ROUNDS=12

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Camadas de proxy à frente da API (Azure App Service = 1).
TRUST_PROXY=1
