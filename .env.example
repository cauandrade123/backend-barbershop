PORT=3000
DB_HOST=localhost
# DB_PORT=3306 é o padrão do MySQL. Só mude se a 3306 já estiver em uso na sua
# máquina (ex.: outro MySQL instalado) — nesse caso use a mesma porta aqui e
# no docker-compose (ele lê essa mesma variável).
DB_PORT=3306
DB_USER=root
DB_NAME=barbearia
DB_PWD=troque_esta_senha
JWT_SECRET=use_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h
